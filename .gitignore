# ---------------------------------------------------------------
# Segredos e ambiente local
# ---------------------------------------------------------------
# Qualquer .env (.env, .env.local, .env.production...) fica fora do git,
# exceto o modelo .env.example, que NÃO deve conter valores reais.
.env
.env.*
!.env.example
/auth.json

# ---------------------------------------------------------------
# Dependências (reinstaladas com composer install / npm install)
# ---------------------------------------------------------------
/vendor
/node_modules

# ---------------------------------------------------------------
# Arquivos gerados pelo build do front (npm run build / npm run dev)
# Se algo aqui for commitado, o Tailwind ainda lê, mas só gera ruído no git.
# ---------------------------------------------------------------
/public/build
/public/hot
/public/fonts-manifest.dev.json

# ---------------------------------------------------------------
# Gerados pelo Laravel
# ---------------------------------------------------------------
/public/storage
/storage/*.key
/storage/pail
*.log

# ---------------------------------------------------------------
# Testes
# ---------------------------------------------------------------
.phpunit.result.cache
/.phpunit.cache
/coverage

# ---------------------------------------------------------------
# Editores, IAs e sistema operacional
# ---------------------------------------------------------------
/.idea
/.vscode
/.zed
/.nova
/.fleet
/.cursor/
/.codex
/.claude/
.phpactor.json
.DS_Store
Thumbs.db
_ide_helper.php
Homestead.json
Homestead.yaml

# ---------------------------------------------------------------
# Pacotes e backups soltos (ex.: zips do projeto enviados para outras pessoas)
# ---------------------------------------------------------------
*.zip
*.bak
